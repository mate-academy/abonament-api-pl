            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (ticket, skill_name) (max_over_time(claude_code_cost_usage_USD_total{ticket=~\"$ticket\"}[$__range])), \"skill_name\", \"poza fazami\", \"skill_name\", \"^$\")",
