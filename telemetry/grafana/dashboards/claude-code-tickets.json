  "templating": {
    "list": [
      {
        "name": "ticket",
        "label": "Ticket",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(sum by (ticket) (max_over_time(claude_code_cost_usage_USD_total{ticket!=\"\"}[$__range])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 3
        },
        "definition": "query_result(sum by (ticket) (max_over_time(claude_code_cost_usage_USD_total{ticket!=\"\"}[$__range])))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "regex": "/ticket=\"([^\"]+)\"/"
      }
    ]
  },
  "annotations": {
    "list": []
  },
